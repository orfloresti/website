---
import type { GetStaticPaths } from 'astro'
import PostView from '~/views/PostView.astro'
import { postPaths } from '~/page-paths'

export const getStaticPaths = (async () => {
  return postPaths('es')
}) satisfies GetStaticPaths

const { post, prev, next, alternates } = Astro.props
---

<PostView post={post} prev={prev} next={next} alternates={alternates} />
