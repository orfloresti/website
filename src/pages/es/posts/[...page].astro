---
import type { GetStaticPaths } from 'astro'
import ArchiveView from '~/views/ArchiveView.astro'
import { archivePaths } from '~/page-paths'

// Note: Pagination like '/', '/2', '/3' only works with spread param like [...page]
export const getStaticPaths = (async ({ paginate }) => {
  return archivePaths(paginate, 'es')
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<ArchiveView page={page} lang="es" />
