---
import type { GetStaticPaths } from 'astro'
import SeriesView from '~/views/SeriesView.astro'
import { seriesPaths } from '~/page-paths'

export const getStaticPaths = (async () => {
  return seriesPaths('es')
}) satisfies GetStaticPaths

const { posts, seriesTitle } = Astro.props
---

<SeriesView posts={posts} seriesTitle={seriesTitle} lang="es" />
