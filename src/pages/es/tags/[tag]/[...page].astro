---
import type { GetStaticPaths } from 'astro'
import TagView from '~/views/TagView.astro'
import { tagPaths } from '~/page-paths'

// Note: Pagination like '/', '/2', '/3' only works with spread param like [...page]
export const getStaticPaths = (async ({ paginate }) => {
  return tagPaths(paginate, 'es')
}) satisfies GetStaticPaths

const { page, tagTitle } = Astro.props
---

<TagView page={page} tagTitle={tagTitle} lang="es" />
