<script>
  const SELECTOR = 'pre.mermaid'
  let diagramCounter = 0

  // Reads a CSS variable and normalizes it to a color mermaid can parse (hex/rgb).
  function readColor(name: string, fallback: string): string {
    const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim()
    if (!raw) return fallback
    const ctx = document.createElement('canvas').getContext('2d')
    if (!ctx) return raw
    ctx.fillStyle = '#000'
    ctx.fillStyle = raw
    return ctx.fillStyle
  }

  async function renderDiagrams() {
    const nodes = document.querySelectorAll<HTMLElement>(SELECTOR)
    if (nodes.length === 0) return
    const { default: mermaid } = await import('mermaid')

    // Mermaid measures text to size the boxes, so the site font must be loaded first,
    // otherwise a fallback font is measured and the real text gets clipped.
    const fontFamily = getComputedStyle(nodes[0]).fontFamily
    try {
      await document.fonts.load(`16px ${fontFamily}`)
      await document.fonts.ready
    } catch {
      // Rendering still works with whatever font is available.
    }

    // Keep the original source so diagrams can be re-rendered on theme change.
    nodes.forEach((node) => {
      if (!node.dataset.source) node.dataset.source = node.textContent ?? ''
    })

    const background = readColor('--theme-background', '#ffffff')
    const foreground = readColor('--theme-foreground', '#000000')
    const accent = readColor('--theme-accent', '#3366cc')
    const separator = readColor('--theme-separator', '#888888')

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      themeVariables: {
        background,
        primaryColor: background,
        primaryTextColor: foreground,
        primaryBorderColor: accent,
        secondaryColor: background,
        tertiaryColor: background,
        lineColor: separator,
        textColor: foreground,
        mainBkg: background,
        nodeBorder: accent,
        clusterBkg: background,
        clusterBorder: separator,
        edgeLabelBackground: background,
        actorBkg: background,
        actorBorder: accent,
        actorTextColor: foreground,
        actorLineColor: separator,
        signalColor: foreground,
        signalTextColor: foreground,
        labelBoxBkgColor: background,
        labelBoxBorderColor: separator,
        labelTextColor: foreground,
        loopTextColor: foreground,
        noteBkgColor: background,
        noteBorderColor: accent,
        noteTextColor: foreground,
        activationBkgColor: separator,
        activationBorderColor: accent,
        sequenceNumberColor: background,
        fontFamily,
      },
    })

    // Render one by one with our own ids. mermaid.run() derives ids from Date.now(), so diagrams
    // rendered in the same millisecond share an id and end up drawn on top of each other.
    for (const node of nodes) {
      try {
        const { svg, bindFunctions } = await mermaid.render(
          `mermaid-diagram-${diagramCounter++}`,
          node.dataset.source ?? '',
        )
        node.innerHTML = svg
        bindFunctions?.(node)
      } catch (error) {
        console.error('Mermaid render failed', error)
      }
    }
  }

  // Renders must not overlap: concurrent runs over the same nodes draw diagrams on top of each other.
  let queue: Promise<void> = Promise.resolve()
  function scheduleRender() {
    queue = queue
      .then(renderDiagrams)
      .catch((error) => console.error('Mermaid render failed', error))
  }

  scheduleRender()

  // Re-render when the site theme changes (data-theme attribute on <html>).
  if (document.querySelector(SELECTOR)) {
    new MutationObserver(scheduleRender).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    })
  }
</script>
